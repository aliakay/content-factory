# Copy to config.env and adjust. Every value is optional; empty = automatic.
# Environment variables with the same name win over this file.

# Address the Studio / Shorts panel / old panel listen on. Empty = this machine's Tailscale IP
# (recommended: the panels then refuse anyone outside your tailnet). 127.0.0.1 = this computer only.
CF_HOST=

# Ports
CF_STUDIO_PORT=8501
CF_SHORTS_PORT=8095
CF_STREAMLIT_PORT=8503
# 0 = don't start the old Streamlit panel
CF_STREAMLIT=1

# Tools. Empty = ~/opt/bin/<tool> if it exists, else the one on PATH.
CF_FFMPEG=
CF_FFPROBE=
CF_CLAUDE=
# OpenRouter (Hesaplar → OpenRouter API). The owner's key here is used when a user has not saved their own;
# the OpenRouter provider runs agents on DeepSeek V4.1 Flash by default (factory/openrouter.py).
OPENROUTER_API_KEY=

# Google Gemini (Hesaplar → Google Gemini API). Used for voice/music/image/video when a user picks Gemini as the
# media provider (factory/gemini.py); spend is recorded in dollars in the gemini_ledger table.
GEMINI_API_KEY=
# Monthly Gemini ceiling in dollars (default 25): a call that would cross it is refused.
CF_GEMINI_MONTHLY_USD=
# Chromium runtime libraries unpacked without root (only for machines missing them); ':'-separated
CF_CHROME_LIBS=
