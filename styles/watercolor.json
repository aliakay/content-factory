 "js": "FX.texture(root, 'watercolor', {strength: 0.9});\nconst svg = E('inset:0');\nconst PAPER = '#fbf6ea', IN = '#2f4b63', INP = '#6f8ea3', OC = '#cf8f44', ROS = '#c0644f', OLV = '#6d7f63',\nSKN = '#e9b98f', DK = '#1d2b36';\nconst R = (() => { let s = 31; return () => (s = (s * 48271) % 2147483647) / 2147483647; })();\nconst fx = (n) => (n).toFixed(1);\nconst blob = (cx, cy, rx, ry, n = 12, wob = .12, rot = 0) => {\nconst pts = [];\nfor (let i = 0; i < n; i++) {\nconst a = i / n * Math.PI * 2, k = 1 + (R() - .5) * 2 * wob;\nconst x = Math.cos(a) * rx * k, y = Math.sin(a) * ry * k;\npts.push([cx + x * Math.cos(rot) - y * Math.sin(rot), cy + x * Math.sin(rot) + y * Math.cos(rot)]);\n}\nconst m = (a, b) => [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];\nconst s0 = m(pts[n - 1], pts[0]);\nlet d = `M${fx(s0[0])} ${fx(s0[1])}`;\nfor (let i = 0; i < n; i++) {\nconst p = pts[i], q = pts[(i + 1) % n], mm = m(p, q);\nd += `Q${fx(p[0])} ${fx(p[1])} ${fx(mm[0])} ${fx(mm[1])}`;\n}\nreturn d + 'Z';\n};\nlet kn = 0;\nconst idOf = () => 'w' + (kn++);\nconst dashes = (w) => `${(w * 6.5).toFixed(0)} ${(w * 1.7).toFixed(0)} ${(w * 3.1).toFixed(0)} ${(w * 5.2).toFixed(0)} ${(w * 1.2).toFixed(0)} ${(w * 9).toFixed(0)} ${(w * 2.4).toFixed(0)} ${(w * 4.1).toFixed(0)}`;\nconst rim = (d, col, w, op, edgeId = 'edge') => {\nconst id = idOf();\nreturn `<clipPath id=\"${id}\"><path d=\"${d}\"/></clipPath><path d=\"${d}\" fill=\"none\" stroke=\"${col}\" stroke-width=\"${w}\" stroke-dasharray=\"${dashes(w)}\" stroke-linecap=\"round\" opacity=\"${op}\" clip-path=\"url(#${id})\" filter=\"url(#${edgeId})\"/>`;\n};\nconst wash = (d, col, op, o = {}) => {\nlet out = `<path d=\"${d}\" fill=\"${col}\" opacity=\"${op}\"/>`;\nif (o.mott !== false) out += `<path d=\"${d}\" fill=\"url(#mott)\" opacity=\"${o.mott ?? .24}\"/>`;\nif (o.gran) out += `<path d=\"${d}\" fill=\"url(#gran)\" opacity=\"${o.gran}\"/>`;\nif (o.rim) out += rim(d, o.rimCol || col, o.rimW || 12, o.rim, o.edge || 'edge');\nreturn out;\n};\nconst limb = (x1, y1, x2, y2, w1, w2, col, op, o = {}) => {\nconst dx = x2 - x1, dy = y2 - y1, L = Math.hypot(dx, dy) || 1, ux = -dy / L, uy = dx / L;\nconst d = `M${fx(x1 + ux * w1)} ${fx(y1 + uy * w1)}L${fx(x2 + ux * w2)} ${fx(y2 + uy * w2)}A${w2} ${w2} 0 0 1 ${fx(x2 - ux * w2)} ${fx(y2 - uy * w2)}L${fx(x1 - ux * w1)} ${fx(y1 - uy * w1)}A${w1} ${w1} 0 0 1 ${fx(x1 + ux * w1)} ${fx(y1 + uy * w1)}Z`;\nreturn wash(d, col, op, o);\n};\nconst dry = (d, col, w, op) => `<path d=\"${d}\" fill=\"none\" stroke=\"${col}\" stroke-width=\"${w}\" opacity=\"${op}\" stroke-linecap=\"round\" filter=\"url(#edge)\"/>`;\nconst bloom = (cx, cy, rx, ry, col, op, rot = 0) => {\nconst a = blob(cx, cy, rx, ry, 10, .2, rot), b = blob(cx + (R() - .5) * 8, cy + (R() - .5) * 8, rx * .52, ry * .48, 9, .26, rot + .4);\nreturn `<path d=\"${a}\" fill=\"${col}\" opacity=\"${op}\"/><path d=\"${a}\" fill=\"none\" stroke=\"${col}\" stroke-width=\"7\" opacity=\"${Math.min(1, op * 2.4).toFixed(2)}\" filter=\"url(#edge)\"/><path d=\"${b}\" fill=\"${PAPER}\" opacity=\".82\"/>`;\n};\nconst cauli = (cx, cy, rx, ry, col, op, rot = 0) => bloom(cx, cy, rx, ry, col, op, rot) +\nbloom(cx + rx * 1.02, cy + ry * .34, rx * .62, ry * .58, col, op * .8, rot + 1.1) +\nbloom(cx - rx * .78, cy + ry * .42, rx * .44, ry * .4, col, op * .7, rot - .7);\nconst donut = (rx, ry, irx, iry) => `M${-rx} 0a${rx} ${ry} 0 1 0 ${rx * 2} 0a${rx} ${ry} 0 1 0 ${-rx * 2} 0M${-irx} 0a${irx} ${iry} 0 1 1 ${irx * 2} 0a${irx} ${iry} 0 1 1 ${-irx * 2} 0`;\nconst simit = (cx, cy, rx, ry, rot, op) => {\nconst irx = rx * .36, iry = ry * .34, d = donut(rx, ry, irx, iry);\nlet sesame = '';\nfor (let i = 0; i < 12; i++) {\nconst a = R() * Math.PI * 2, rr = .55 + R() * .34;\nsesame += `<circle cx=\"${fx(Math.cos(a) * rx * rr)}\" cy=\"${fx(Math.sin(a) * ry * rr)}\" r=\"${(1.6 + R() * 1.5).toFixed(1)}\" fill=\"${i % 3 ? PAPER : DK}\" opacity=\"${i % 3 ? .75 : .35}\"/>`;\n}\nreturn `<g transform=\"translate(${cx} ${cy}) rotate(${rot})\">\n<path d=\"${d}\"